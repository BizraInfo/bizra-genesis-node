# ╔═══════════════════════════════════════════════════════════════════════╗
# ║  BIZRA GENESIS NODE - PRODUCTION ENVIRONMENT VARIABLES               ║
# ║  SECURITY NOTE: Replace all placeholder values before deployment     ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════════════════════
# APPLICATION CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
NODE_ENV=production
RUST_LOG=info,bizra_genesis_node=debug
RUST_BACKTRACE=0
PORT=8080
METRICS_PORT=9090

# ═══════════════════════════════════════════════════════════════════════════
# TLS/SSL CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
DOMAIN=console.bizra.ai
SSL_EMAIL=admin@bizra.ai
STAGING=0

# ═══════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# TODO: Replace with your Neon database URL from https://console.neon.tech
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://bizra:CHANGE_THIS_PASSWORD@postgres:5432/bizra_genesis
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
DATABASE_MAX_CONNECTIONS=100
DATABASE_MIN_CONNECTIONS=10
DATABASE_CONNECT_TIMEOUT=30
DATABASE_IDLE_TIMEOUT=600

# ═══════════════════════════════════════════════════════════════════════════
# REDIS CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
REDIS_URL=redis://:CHANGE_THIS_PASSWORD@redis:6379
REDIS_PASSWORD=CHANGE_THIS_PASSWORD
REDIS_MAX_CONNECTIONS=50
REDIS_POOL_TIMEOUT=30

# ═══════════════════════════════════════════════════════════════════════════
# SECURITY & ENCRYPTION
# ═══════════════════════════════════════════════════════════════════════════
JWT_SECRET=YOUR_JWT_SECRET_HERE_GENERATE_WITH_openssl_rand_base64_64
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=604800
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE_GENERATE_WITH_openssl_rand_hex_32
DEPLOYMENT_ID=BIZRA-0D8030B4-PROD
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# ═══════════════════════════════════════════════════════════════════════════
# AI PROVIDER CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
OPENAI_API_KEY=sk-CHANGE_THIS
ANTHROPIC_API_KEY=sk-ant-CHANGE_THIS
OLLAMA_BASE_URL=http://ollama:11434

# ═══════════════════════════════════════════════════════════════════════════
# OBSERVABILITY
# ═══════════════════════════════════════════════════════════════════════════
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_THIS_PASSWORD
PROMETHEUS_RETENTION_DAYS=30

# ═══════════════════════════════════════════════════════════════════════════
# CORS & ALLOWED ORIGINS
# ═══════════════════════════════════════════════════════════════════════════
ALLOWED_ORIGINS=https://bizra.ai,https://www.bizra.ai
CORS_MAX_AGE=3600

# ═══════════════════════════════════════════════════════════════════════════
# PERFORMANCE TUNING
# ═══════════════════════════════════════════════════════════════════════════
MAX_REQUEST_SIZE=10485760
WORKER_THREADS=4
CONSENSUS_TIMEOUT=30000
CACHE_TTL=3600

# ═══════════════════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════════════════════════════
ENABLE_WEBSOCKET=true
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_RATE_LIMITING=true
ENABLE_COMPRESSION=true
