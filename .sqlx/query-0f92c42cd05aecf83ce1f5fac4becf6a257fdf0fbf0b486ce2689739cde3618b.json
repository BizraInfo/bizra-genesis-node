  "query": "\n            SELECT\n                id,\n                contributor_id,\n                impact_domain,\n                raw_score,\n                weight,\n                normalized_score,\n                payload_hash,\n                status as \"status: _\",\n                created_at,\n                verified_at\n            FROM poi_attestations\n            WHERE contributor_id = $1\n            ORDER BY created_at DESC\n            LIMIT $2\n            ",
