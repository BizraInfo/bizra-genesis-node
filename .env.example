# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL - Required for Phase 2+)
# ============================================================================
# PostgreSQL connection string
# Format: postgres://username:password@hostname:port/database
DATABASE_URL="postgres://bizra_user:bizra_password@localhost:5432/bizra_genesis"
TEST_DATABASE_URL="postgres://bizra_user:bizra_password@localhost:5432/bizra_genesis_test"

# Connection pool configuration
DATABASE_MAX_CONNECTIONS=100    # Maximum connections in pool
DATABASE_MIN_CONNECTIONS=10     # Minimum connections to maintain

# ============================================================================
# REDIS CONFIGURATION (Caching Layer - Required for Phase 2+)
# ============================================================================
# Redis connection string for high-performance caching (<1ms latency)
# Format: redis://[username:password@]hostname:port[/database]
REDIS_URL="redis://localhost:6379/0"
TEST_REDIS_URL="redis://localhost:6379/1"

# Redis connection pool configuration
REDIS_POOL_SIZE=20              # Number of connections in pool
REDIS_TIMEOUT_SECONDS=5         # Connection timeout

# Cache TTL (Time-To-Live) configuration
CACHE_TTL_ROUTER_STATE=300      # Router state cache TTL (5 minutes)
CACHE_TTL_AGENT_METRICS=60      # Agent metrics cache TTL (1 minute)
CACHE_TTL_CONSENSUS_RESULTS=600 # Consensus results cache TTL (10 minutes)

# ============================================================================
# AI MODEL API KEYS
# ============================================================================
# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # Optional: Format: pplx-...
OPENAI_API_KEY="your_openai_api_key_here"             # Optional, for OpenAI models. Format: sk-proj-...
GOOGLE_API_KEY="your_google_api_key_here"             # Optional, for Google Gemini models.
MISTRAL_API_KEY="your_mistral_key_here"               # Optional, for Mistral AI models.
XAI_API_KEY="YOUR_XAI_KEY_HERE"                       # Optional, for xAI AI models.
GROQ_API_KEY="YOUR_GROQ_KEY_HERE"                     # Optional, for Groq models.
OPENROUTER_API_KEY="YOUR_OPENROUTER_KEY_HERE"         # Optional, for OpenRouter models.
AZURE_OPENAI_API_KEY="your_azure_key_here"            # Optional, for Azure OpenAI models (requires endpoint in .taskmaster/config.json).
OLLAMA_API_KEY="your_ollama_api_key_here"             # Optional: For remote Ollama servers that require authentication.
OLLAMA_BASE_URL="http://localhost:11434"              # Ollama server endpoint
GITHUB_API_KEY="your_github_api_key_here"             # Optional: For GitHub import/export features. Format: ghp_... or github_pat_...

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
RUST_LOG=info,bizra_genesis_node=debug,sqlx=warn
RUST_BACKTRACE=1
RAYON_NUM_THREADS=8
TOKIO_WORKER_THREADS=8

# ============================================================================
# CONSENSUS CONFIGURATION
# ============================================================================
# Weighted-Score Consensus parameters
IHSAN_FLOOR=0.85                # Minimum Ihsan quality threshold (0.0-1.0)
CONSENSUS_TIMEOUT_MS=5000       # Consensus timeout in milliseconds

# Thompson Sampling router configuration
THOMPSON_INITIAL_ALPHA=1.0      # Initial alpha parameter (successes + 1)
THOMPSON_INITIAL_BETA=1.0       # Initial beta parameter (failures + 1)

# ============================================================================
# GENESIS VALIDATION (Ramadan 2023 Spiritual Principles)
# ============================================================================
GENESIS_ENABLED=true            # Enable spiritual validation layer
GENESIS_MIN_ALIGNMENT=0.70      # Minimum spiritual alignment threshold (0.0-1.0)

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Cryptographic trust receipts (Ed25519 + BLAKE3)
TRUST_BRIDGE_ENABLED=true       # Enable cryptographic signing for receipts

# API authentication (optional)
API_KEY_ENABLED=false           # Enable API key authentication
API_KEY=your-secret-api-key-here  # API key for authentication

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================
# Prometheus metrics
METRICS_ENABLED=true            # Enable Prometheus metrics export
METRICS_PORT=9090               # Prometheus metrics HTTP port

# Health checks
HEALTH_CHECK_PORT=8080          # Health check HTTP port
HEALTH_CHECK_INTERVAL_SECONDS=30  # Health check interval

# Distributed tracing (OpenTelemetry)
TRACING_ENABLED=false           # Enable OpenTelemetry tracing
JAEGER_ENDPOINT=http://localhost:14268/api/traces  # Jaeger collector endpoint

# ============================================================================
# PERFORMANCE OPTIMIZATION
# ============================================================================
# SIMD optimization (requires CPU support)
ENABLE_AVX2=true                # Enable AVX2 SIMD instructions
ENABLE_AVX512=false             # Enable AVX512 SIMD instructions (experimental)

# Memory allocator
USE_MIMALLOC=true               # Use mimalloc for better performance

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_AGENTFOLD_PHI=true      # Enable AgentFold Φ-optimization (Golden Ratio)
FEATURE_PARETO_CONSENSUS=true   # Enable Pareto optimization in consensus
FEATURE_PROOF_OF_IMPACT=true    # Enable Proof-of-Impact tracking