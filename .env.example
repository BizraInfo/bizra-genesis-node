# BIZRA Node0 - Environment Configuration
# Document ID: BIZRA-NODE0-v1.0.0-GENESIS
# Copy this file to .env and fill in your values

# ================================================
# DATABASE CONFIGURATION
# ================================================

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bizra_genesis
DB_USER=bizra_node0
DB_PASSWORD=your_secure_password_here

# Neo4j Graph Database
GRAPH_HOST=localhost
GRAPH_BOLT_PORT=7687
GRAPH_HTTP_PORT=7474
GRAPH_USER=neo4j
GRAPH_PASSWORD=your_neo4j_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ================================================
# APPLICATION PORTS
# ================================================

# Rust API Server
API_HOST=0.0.0.0
API_PORT=8080

# Node.js Telemetry Bridge
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=3001

# WebSocket Telemetry
TELEMETRY_WS_HOST=0.0.0.0
TELEMETRY_WS_PORT=3002

# React Dashboard
DASHBOARD_PORT=3000

# ================================================
# OLLAMA CONFIGURATION
# ================================================

OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_URL=http://localhost:11434

# Default models for PAT agents
OLLAMA_MODEL_REASONER=deepseek-r1:7b
OLLAMA_MODEL_CREATIVE=qwen2.5:7b
OLLAMA_MODEL_VISION=llama3.2-vision:11b
OLLAMA_MODEL_COMMUNICATOR=mistral:7b
OLLAMA_MODEL_CODE=codellama:13b
OLLAMA_MODEL_EMBED=nomic-embed-text

# ================================================
# LM STUDIO CONFIGURATION
# ================================================

LMSTUDIO_HOST=localhost
LMSTUDIO_PORT=1234
LMSTUDIO_URL=http://localhost:1234

# LM Studio models (loaded via LM Studio GUI)
LMSTUDIO_MODEL_PLANNER=agentflow-7b
LMSTUDIO_MODEL_CODER=deepseek-coder-v2
LMSTUDIO_MODEL_LARGE=qwen2.5-coder-32b
LMSTUDIO_MODEL_FLAGSHIP=llama-3.3-70b

# Preferred backend for ExecutionPlanner agent
# Options: ollama, lmstudio
EXECUTION_PLANNER_BACKEND=lmstudio

# ================================================
# HYPERGRAPH RAG CONFIGURATION
# ================================================

# Knowledge enrichment for PAT agents
KNOWLEDGE_ENRICHMENT=true

# Source data lake path
KNOWLEDGE_SOURCE_ROOT=C:\BIZRA-DATA-LAKE

# Graph output directory
KNOWLEDGE_GRAPH_DIR=./knowledge/graph

# Embedding model
KNOWLEDGE_EMBED_MODEL=all-MiniLM-L6-v2

# Max context tokens for enrichment
KNOWLEDGE_MAX_TOKENS=2000

# ================================================
# NODE CONFIGURATION
# ================================================

# Node Identity
NODE_ID=NODE0-TITAN
NODE_NAME=BIZRA Genesis Node
NODE_VERSION=1.0.0

# Hardware Profile (auto-detected, but can override)
NODE_CPU_CORES=24
NODE_RAM_GB=128
NODE_GPU_VRAM_GB=16
NODE_STORAGE_GB=3000

# ================================================
# PROOF-OF-IMPACT (PoI) CONFIGURATION
# ================================================

# Ihsan threshold for verification (0.0 - 1.0)
POI_IHSAN_THRESHOLD=0.85

# Reward rates (simulated, pre-mainnet)
POI_BZC_RATE=0.1
POI_IMP_RATE=0.5

# ================================================
# SECURITY
# ================================================

# JWT Secret for API authentication
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Encryption key for sensitive data
ENCRYPTION_KEY=your_encryption_key_here_min_32_chars

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ================================================
# LOGGING
# ================================================

# Log level: trace, debug, info, warn, error
LOG_LEVEL=info

# Log output: console, file, both
LOG_OUTPUT=both

# Log file paths
LOG_DIR=./logs
LOG_FILE_API=apiserver.log
LOG_FILE_BRIDGE=bridge.log

# ================================================
# TELEMETRY
# ================================================

# Telemetry broadcast interval (milliseconds)
TELEMETRY_INTERVAL_MS=1000

# Metrics retention (hours)
METRICS_RETENTION_HOURS=168

# ================================================
# ASSET REGISTRY
# ================================================

# Directories to index (comma-separated)
ASSET_INDEX_PATHS=./,~/Documents/BIZRA-Research

# File extensions to index
ASSET_INDEX_EXTENSIONS=.rs,.ts,.tsx,.js,.jsx,.py,.md,.json,.sql,.yaml,.yml,.toml

# Max file size to index (bytes)
ASSET_MAX_FILE_SIZE=10485760

# ================================================
# DEVELOPMENT
# ================================================

# Environment: development, staging, production
NODE_ENV=development

# Enable debug mode
DEBUG=false

# Enable hot reload for dashboard
HOT_RELOAD=true
