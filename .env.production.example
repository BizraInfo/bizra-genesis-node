# ╔═══════════════════════════════════════════════════════════════════════╗
# ║  BIZRA GENESIS NODE - PRODUCTION ENVIRONMENT TEMPLATE                ║
# ║  Alpha-100 Deployment Configuration                                  ║
# ║                                                                       ║
# ║  SECURITY WARNING:                                                   ║
# ║  1. Copy this file to .env.production                                ║
# ║  2. Replace ALL placeholder values with secure production values     ║
# ║  3. Generate secrets using: ./scripts/generate-secrets.sh            ║
# ║  4. NEVER commit .env.production to version control                  ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════════════════════
# APPLICATION CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
NODE_ENV=production
RUST_LOG=info,bizra_genesis_node=debug
RUST_BACKTRACE=0

# Server ports (internal)
PORT=8080
METRICS_PORT=9090

# ═══════════════════════════════════════════════════════════════════════════
# TLS/SSL CONFIGURATION (Required for production deployment)
# ═══════════════════════════════════════════════════════════════════════════

# Your production domain (e.g., console.bizra.ai)
# Pre-requisite: DNS A record must point to your server's public IP
DOMAIN=console.bizra.ai

# Email for Let's Encrypt notifications (certificate expiration alerts)
SSL_EMAIL=admin@bizra.ai

# Let's Encrypt staging mode (0 = production, 1 = staging/testing)
# Use STAGING=1 for testing to avoid rate limits
STAGING=0

# ═══════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# SECURITY: Generate strong password using: openssl rand -base64 32
DATABASE_URL=postgresql://bizra:CHANGE_THIS_TO_SECURE_PASSWORD@postgres:5432/bizra_genesis

# PostgreSQL password (must match DATABASE_URL password)
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# Connection pool settings
DATABASE_MAX_CONNECTIONS=100
DATABASE_MIN_CONNECTIONS=10
DATABASE_CONNECT_TIMEOUT=30
DATABASE_IDLE_TIMEOUT=600

# ═══════════════════════════════════════════════════════════════════════════
# REDIS CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Redis connection string
# Format: redis://:password@host:port
# SECURITY: Generate strong password using: openssl rand -base64 32
REDIS_URL=redis://:CHANGE_THIS_TO_SECURE_PASSWORD@redis:6379

# Redis password (must match REDIS_URL password)
REDIS_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# Redis pool settings
REDIS_MAX_CONNECTIONS=50
REDIS_POOL_TIMEOUT=30

# ═══════════════════════════════════════════════════════════════════════════
# SECURITY & ENCRYPTION
# ═══════════════════════════════════════════════════════════════════════════

# JWT secret for signing tokens (minimum 256 bits / 32 bytes)
# SECURITY: Generate using: openssl rand -base64 32
# CRITICAL: This secret must remain confidential
JWT_SECRET=CHANGE_THIS_TO_RANDOM_256_BIT_SECRET

# JWT token expiration times (seconds)
# Access token: 24 hours (86400s) for Alpha-100 period
# Refresh token: 7 days (604800s)
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=604800

# Encryption key for data at rest (minimum 256 bits / 32 bytes)
# SECURITY: Generate using: openssl rand -base64 32
# CRITICAL: Backup this key securely - data loss if lost
ENCRYPTION_KEY=CHANGE_THIS_TO_RANDOM_256_BIT_KEY

# Rate limiting configuration
# Requests per window (per IP address)
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# ═══════════════════════════════════════════════════════════════════════════
# AI PROVIDER CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# OpenAI API Key (get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-CHANGE_THIS_TO_YOUR_OPENAI_KEY

# Anthropic API Key (get from: https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-CHANGE_THIS_TO_YOUR_ANTHROPIC_KEY

# Ollama base URL (local LLM inference)
OLLAMA_BASE_URL=http://ollama:11434

# ═══════════════════════════════════════════════════════════════════════════
# OBSERVABILITY (Grafana, Prometheus, Loki)
# ═══════════════════════════════════════════════════════════════════════════

# Grafana admin credentials
# SECURITY: Change default password immediately
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# Prometheus metrics retention
PROMETHEUS_RETENTION_DAYS=30

# ═══════════════════════════════════════════════════════════════════════════
# CORS & ALLOWED ORIGINS
# ═══════════════════════════════════════════════════════════════════════════

# Comma-separated list of allowed origins for CORS
# Include your production domain(s)
ALLOWED_ORIGINS=https://console.bizra.ai,https://bizra.ai,https://www.bizra.ai

# CORS preflight cache duration (seconds)
CORS_MAX_AGE=3600

# ═══════════════════════════════════════════════════════════════════════════
# PERFORMANCE TUNING
# ═══════════════════════════════════════════════════════════════════════════

# Maximum request body size (bytes) - 10MB default
MAX_REQUEST_SIZE=10485760

# Worker threads for async runtime
# Recommended: Number of CPU cores
WORKER_THREADS=4

# Consensus algorithm timeout (milliseconds)
CONSENSUS_TIMEOUT=30000

# Cache TTL (seconds)
CACHE_TTL=3600

# ═══════════════════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════════════════════════════

# Enable/disable features (true/false)
ENABLE_WEBSOCKET=true
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_RATE_LIMITING=true
ENABLE_COMPRESSION=true

# ═══════════════════════════════════════════════════════════════════════════
# ALPHA-100 PROGRAM CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Maximum Alpha-100 participants
ALPHA_100_MAX_USERS=100

# Alpha-100 program duration (days)
ALPHA_100_DURATION_DAYS=90

# Enable Alpha-100 invite code validation
ALPHA_100_REQUIRE_INVITE=true

# ═══════════════════════════════════════════════════════════════════════════
# DEPLOYMENT METADATA (Optional - for tracking)
# ═══════════════════════════════════════════════════════════════════════════

# Deployment environment identifier
DEPLOYMENT_ENV=production

# Deployment region/zone
DEPLOYMENT_REGION=us-east-1

# Git commit SHA (auto-populated by CI/CD)
GIT_COMMIT_SHA=

# Deployment timestamp (auto-populated by CI/CD)
DEPLOYMENT_TIMESTAMP=

# ═══════════════════════════════════════════════════════════════════════════
# END OF CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# DEPLOYMENT CHECKLIST:
# ☐ Copy this file to .env.production
# ☐ Update DOMAIN to your production domain
# ☐ Update SSL_EMAIL to your email address
# ☐ Generate JWT_SECRET using: openssl rand -base64 32
# ☐ Generate ENCRYPTION_KEY using: openssl rand -base64 32
# ☐ Generate DATABASE_PASSWORD using: openssl rand -base64 32
# ☐ Generate REDIS_PASSWORD using: openssl rand -base64 32
# ☐ Update GRAFANA_PASSWORD to a secure password
# ☐ Add your OpenAI API key (if using OpenAI models)
# ☐ Add your Anthropic API key (if using Claude models)
# ☐ Update ALLOWED_ORIGINS with your production domains
# ☐ Run pre-flight check: ./scripts/preflight-check.sh
# ☐ Deploy: ./scripts/setup-production-ssl.sh
