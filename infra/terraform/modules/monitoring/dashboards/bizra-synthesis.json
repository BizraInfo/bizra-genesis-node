{
  "dashboard": {
    "title": "BIZRA Genesis Node - Synthesis",
    "tags": ["bizra", "synthesis"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "panels": [
      {
        "id": 1,
        "title": "Synthesis Throughput",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(synthesis_requests_total[5m])",
            "legendFormat": "Requests/s"
          },
          {
            "expr": "rate(synthesis_success_total[5m])",
            "legendFormat": "Success/s"
          },
          {
            "expr": "rate(synthesis_errors_total[5m])",
            "legendFormat": "Errors/s"
          }
        ]
      },
      {
        "id": 2,
        "title": "End-to-End Latency",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(synthesis_duration_seconds_bucket[5m]))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(synthesis_duration_seconds_bucket[5m]))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(synthesis_duration_seconds_bucket[5m]))",
            "legendFormat": "P99"
          }
        ]
      },
      {
        "id": 3,
        "title": "Quality Scores",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "avg(accuracy_score)",
            "legendFormat": "Accuracy"
          },
          {
            "expr": "avg(safety_score)",
            "legendFormat": "Safety"
          },
          {
            "expr": "avg(ihsan_score)",
            "legendFormat": "Ihsan"
          }
        ]
      }
    ]
  }
}
