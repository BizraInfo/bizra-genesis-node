{
  "name": "bizra-contract-tests",
  "version": "1.0.0",
  "description": "Contract testing for BIZRA Genesis Node API",
  "type": "module",
  "scripts": {
    "test:consumer": "jest --testMatch='**/consumer/**/*.test.ts'",
    "test:provider": "jest --testMatch='**/provider/**/*.test.ts'",
    "test:all": "npm run test:consumer && npm run test:provider",
    "pact:publish": "node scripts/publish-pacts.js",
    "pact:verify": "node scripts/verify-pacts.js",
    "pact:can-deploy": "npx pact-broker can-i-deploy --pacticipant BizraDashboard --version $npm_package_version --to production"
  },
  "keywords": ["pact", "contract-testing", "api"],
  "author": "BIZRA Lab",
  "license": "MIT",
  "dependencies": {
    "@pact-foundation/pact": "^12.3.0",
    "@pact-foundation/pact-node": "^10.18.0",
    "axios": "^1.6.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  }
}
