# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  BIZRA GENESIS NODE - PRODUCTION DOCKERFILE                              ║
# ║  Multi-stage build for optimized production deployment                   ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════════════════════
# STAGE 1: Rust Builder
# ═══════════════════════════════════════════════════════════════════════════
FROM rust:1.75-slim as rust-builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy Cargo files
COPY Cargo.toml Cargo.lock ./
COPY bizra-moe/Cargo.toml bizra-moe/

# Create dummy src to cache dependencies
RUN mkdir -p src && \
    echo "fn main() {}" > src/main.rs && \
    mkdir -p bizra-moe/src && \
    echo "fn main() {}" > bizra-moe/src/lib.rs

# Build dependencies (cached layer)
RUN cargo build --release --example websocket_demo

# Remove dummy files
RUN rm -rf src bizra-moe/src

# Copy actual source
COPY src ./src
COPY bizra-moe/src ./bizra-moe/src
COPY examples ./examples

# Build actual application
RUN cargo build --release --example websocket_demo

# ═══════════════════════════════════════════════════════════════════════════
# STAGE 2: Frontend Builder
# ═══════════════════════════════════════════════════════════════════════════
FROM node:20-slim as frontend-builder

WORKDIR /build

# Copy package files
COPY apps/dashboard/package*.json ./

# Install dependencies
RUN npm ci

# Copy source
COPY apps/dashboard ./

# Build production bundle
RUN npm run build

# ═══════════════════════════════════════════════════════════════════════════
# STAGE 3: Runtime Image (Minimal)
# ═══════════════════════════════════════════════════════════════════════════
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 bizra

WORKDIR /app

# Copy WebSocket server binary
COPY --from=rust-builder /build/target/release/examples/websocket_demo /app/websocket_demo

# Copy frontend build (optional, for serving static files)
COPY --from=frontend-builder /build/dist /app/public

# Set ownership
RUN chown -R bizra:bizra /app

# Switch to non-root user
USER bizra

# Expose WebSocket port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# Run WebSocket server
CMD ["/app/websocket_demo"]
