{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "bizra-genesis-dashboard",
  "version": 2,
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "regions": ["iad1", "fra1", "syd1"],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.bizra.ai",
    "NEXT_PUBLIC_WS_URL": "wss://ws.bizra.ai"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.bizra.ai/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.bizra.info" }],
      "destination": "https://bizra.info",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.bizra.ai" }],
      "destination": "https://bizra.ai",
      "permanent": true
    }
  ]
}
