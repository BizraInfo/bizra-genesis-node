{
  "dashboard": {
    "id": null,
    "uid": "bizra-genesis-node",
    "title": "BIZRA Genesis Node - Elite Performance Dashboard",
    "tags": ["bizra", "performance", "slo"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 0,
    "refresh": "30s",
    
    "panels": [
      {
        "id": 1,
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
        "type": "row",
        "title": "SLO Compliance Overview"
      },
      {
        "id": 2,
        "gridPos": { "h": 6, "w": 6, "x": 0, "y": 4 },
        "type": "stat",
        "title": "HTTP Latency P95 SLO",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"bizra-genesis-node\"}[5m])) by (le))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.4 },
                { "color": "red", "value": 0.5 }
              ]
            },
            "unit": "s",
            "decimals": 3,
            "mappings": []
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "text": {},
          "textMode": "value_and_name"
        },
        "pluginVersion": "10.0.0"
      },
      {
        "id": 3,
        "gridPos": { "h": 6, "w": 6, "x": 6, "y": 4 },
        "type": "stat",
        "title": "Error Rate SLO",
        "targets": [
          {
            "expr": "(sum(rate(http_requests_total{job=\"bizra-genesis-node\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"bizra-genesis-node\"}[5m]))) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.5 },
                { "color": "red", "value": 1.0 }
              ]
            },
            "unit": "percent",
            "decimals": 2,
            "mappings": []
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "text": {},
          "textMode": "value_and_name"
        },
        "pluginVersion": "10.0.0"
      },
      {
        "id": 4,
        "gridPos": { "h": 6, "w": 6, "x": 12, "y": 4 },
        "type": "stat",
        "title": "Availability SLO",
        "targets": [
          {
            "expr": "(1 - (sum(rate(http_requests_total{job=\"bizra-genesis-node\",status=~\"5..\"}[1h])) / sum(rate(http_requests_total{job=\"bizra-genesis-node\"}[1h])))) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 99.9 },
                { "color": "green", "value": 99.95 }
              ]
            },
            "unit": "percent",
            "decimals": 3,
            "mappings": []
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "text": {},
          "textMode": "value_and_name"
        },
        "pluginVersion": "10.0.0"
      },
      {
        "id": 5,
        "gridPos": { "h": 6, "w": 6, "x": 18, "y": 4 },
        "type": "stat",
        "title": "Consensus Finalization P95",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(consensus_finalization_duration_seconds_bucket{job=\"bizra-genesis-node\"}[5m])) by (le))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1.5 },
                { "color": "red", "value": 2.0 }
              ]
            },
            "unit": "s",
            "decimals": 2,
            "mappings": []
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "text": {},
          "textMode": "value_and_name"
        },
        "pluginVersion": "10.0.0"
      },
      
      {
        "id": 10,
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 10 },
        "type": "row",
        "title": "HTTP Performance Metrics"
      },
      {
        "id": 11,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
        "type": "timeseries",
        "title": "HTTP Request Latency (P50/P95/P99)",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"bizra-genesis-node\"}[5m])) by (le))",
            "legendFormat": "P50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"bizra-genesis-node\"}[5m])) by (le))",
            "legendFormat": "P95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"bizra-genesis-node\"}[5m])) by (le))",
            "legendFormat": "P99",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10,
              "spanNulls": false,
              "showPoints": "never"
            },
            "color": { "mode": "palette-classic" },
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.5 },
                { "color": "red", "value": 1.0 }
              ]
            }
          }
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull", "max"] },
          "tooltip": { "mode": "multi", "sort": "none" }
        }
      },
      {
        "id": 12,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
        "type": "timeseries",
        "title": "HTTP Request Rate by Status",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"bizra-genesis-node\"}[5m])) by (status)",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 20,
              "stacking": { "mode": "normal" }
            },
            "unit": "reqps",
            "color": { "mode": "palette-classic" }
          }
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull", "max"] },
          "tooltip": { "mode": "multi", "sort": "none" }
        }
      },
      
      {
        "id": 20,
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 22 },
        "type": "row",
        "title": "Security & Performance Hotspots"
      },
      {
        "id": 21,
        "gridPos": { "h": 6, "w": 8, "x": 0, "y": 26 },
        "type": "stat",
        "title": "Critical Security Hotspots",
        "targets": [
          {
            "expr": "scanner_security_hotspots_total{severity=\"critical\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 1 }
              ]
            },
            "unit": "short",
            "mappings": []
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 22,
        "gridPos": { "h": 6, "w": 8, "x": 8, "y": 26 },
        "type": "stat",
        "title": "High Security Hotspots",
        "targets": [
          {
            "expr": "scanner_security_hotspots_total{severity=\"high\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 5 },
                { "color": "red", "value": 10 }
              ]
            },
            "unit": "short",
            "mappings": []
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 23,
        "gridPos": { "h": 6, "w": 8, "x": 16, "y": 26 },
        "type": "stat",
        "title": "Performance Bottlenecks (High Impact)",
        "targets": [
          {
            "expr": "scanner_performance_bottlenecks_total{impact=~\"memory_pressure|response_latency\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 10 },
                { "color": "red", "value": 20 }
              ]
            },
            "unit": "short",
            "mappings": []
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 24,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
        "type": "table",
        "title": "Security Hotspots by Type",
        "targets": [
          {
            "expr": "scanner_security_hotspots_total",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "type": "Hotspot Type",
                "severity": "Severity",
                "Value": "Count"
              }
            }
          }
        ]
      },
      {
        "id": 25,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
        "type": "table",
        "title": "Performance Bottlenecks by Type",
        "targets": [
          {
            "expr": "scanner_performance_bottlenecks_total",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "type": "Bottleneck Type",
                "impact": "Impact",
                "Value": "Count"
              }
            }
          }
        ]
      },
      
      {
        "id": 30,
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 40 },
        "type": "row",
        "title": "Infrastructure Health"
      },
      {
        "id": 31,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
        "type": "timeseries",
        "title": "Pod Memory Usage",
        "targets": [
          {
            "expr": "container_memory_working_set_bytes{namespace=\"bizra-production\",container=\"bizra-genesis-node\"} / container_spec_memory_limit_bytes{namespace=\"bizra-production\",container=\"bizra-genesis-node\"} * 100",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 80 },
                { "color": "red", "value": 90 }
              ]
            }
          }
        }
      },
      {
        "id": 32,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
        "type": "timeseries",
        "title": "Pod CPU Usage",
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{namespace=\"bizra-production\",container=\"bizra-genesis-node\"}[5m]) / on(pod) container_spec_cpu_quota{namespace=\"bizra-production\",container=\"bizra-genesis-node\"} * 100",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 70 },
                { "color": "red", "value": 90 }
              ]
            }
          }
        }
      },
      {
        "id": 33,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
        "type": "timeseries",
        "title": "HPA Replica Count",
        "targets": [
          {
            "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"bizra-production\"}",
            "legendFormat": "Current",
            "refId": "A"
          },
          {
            "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"bizra-production\"}",
            "legendFormat": "Desired",
            "refId": "B"
          },
          {
            "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"bizra-production\"}",
            "legendFormat": "Max",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "stepAfter"
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 34,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 52 },
        "type": "timeseries",
        "title": "Database Connection Pool",
        "targets": [
          {
            "expr": "pg_stat_database_numbackends{datname=\"bizra_production\"}",
            "legendFormat": "Active Connections",
            "refId": "A"
          },
          {
            "expr": "pg_settings_max_connections",
            "legendFormat": "Max Connections",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth"
            },
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 80 },
                { "color": "red", "value": 90 }
              ]
            }
          }
        }
      },
      
      {
        "id": 40,
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 60 },
        "type": "row",
        "title": "Business Metrics"
      },
      {
        "id": 41,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 64 },
        "type": "timeseries",
        "title": "Transaction Processing Rate",
        "targets": [
          {
            "expr": "rate(consensus_transactions_processed_total{job=\"bizra-genesis-node\"}[5m])",
            "legendFormat": "tx/sec",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 20
            },
            "unit": "ops"
          }
        }
      },
      {
        "id": 42,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 64 },
        "type": "timeseries",
        "title": "API Request Volume by Endpoint",
        "targets": [
          {
            "expr": "topk(10, sum(rate(http_requests_total{job=\"bizra-genesis-node\"}[5m])) by (endpoint))",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "reqps"
          }
        }
      }
    ],
    
    "templating": {
      "list": [
        {
          "name": "namespace",
          "type": "query",
          "query": "label_values(kube_pod_info, namespace)",
          "current": { "text": "bizra-production", "value": "bizra-production" },
          "multi": false,
          "includeAll": false
        },
        {
          "name": "pod",
          "type": "query",
          "query": "label_values(kube_pod_info{namespace=\"$namespace\"}, pod)",
          "current": { "text": "All", "value": "$__all" },
          "multi": true,
          "includeAll": true
        }
      ]
    },
    
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "Prometheus",
          "expr": "changes(kube_deployment_status_replicas_updated{namespace=\"bizra-production\"}[5m]) > 0",
          "tagKeys": "deployment",
          "titleFormat": "Deployment: {{deployment}}",
          "textFormat": "Replicas updated",
          "iconColor": "blue"
        },
        {
          "name": "Alerts",
          "datasource": "Prometheus",
          "expr": "ALERTS{alertstate=\"firing\",namespace=\"bizra-production\"}",
          "tagKeys": "alertname,severity",
          "titleFormat": "{{alertname}}",
          "textFormat": "{{annotations.summary}}",
          "iconColor": "red"
        }
      ]
    },
    
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    }
  }
}
